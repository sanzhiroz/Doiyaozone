rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Hardened Global Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isVerifiedUser() && (
        request.auth.token.email == 'sanzhiroz@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidCount(val) {
      return (val is int || val is number) && val >= 0 && val <= 10000;
    }

    // 3. Entity Validation Blueprint: MedicalLog
    function isValidMedicalLog(data, logId) {
      return data.keys().hasAll([
        'id',
        'authorUid',
        'serviceUnitCode',
        'serviceUnitName',
        'date',
        'doctorName',
        'hospital',
        'workTime',
        'generalPractice',
        'chronicCare',
        'homeVisit',
        'medicalCert',
        'specialProcedure',
        'reporterPrefix',
        'reporterFirstName',
        'reporterLastName',
        'reporterPosition',
        'reporterLevel',
        'notes',
        'visibility',
        'createdAt',
        'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'id',
        'authorUid',
        'serviceUnitCode',
        'serviceUnitName',
        'date',
        'doctorName',
        'hospital',
        'workTime',
        'generalPractice',
        'chronicCare',
        'homeVisit',
        'medicalCert',
        'specialProcedure',
        'reporterPrefix',
        'reporterFirstName',
        'reporterLastName',
        'reporterPosition',
        'reporterLevel',
        'notes',
        'visibility',
        'createdAt',
        'updatedAt'
      ]) &&
      data.id is string && data.id == logId && data.id.size() >= 1 && data.id.size() <= 128 && data.id.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.authorUid is string && data.authorUid.size() >= 1 && data.authorUid.size() <= 128 && data.authorUid.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.serviceUnitCode is string && data.serviceUnitCode.size() == 5 && data.serviceUnitCode.matches('^[0-9]{5}$') &&
      data.serviceUnitName is string && data.serviceUnitName.size() >= 1 && data.serviceUnitName.size() <= 120 &&
      data.date is string && data.date.size() == 10 && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
      data.doctorName is string && data.doctorName.size() >= 1 && data.doctorName.size() <= 120 &&
      data.hospital is string && data.hospital.size() >= 1 && data.hospital.size() <= 120 &&
      data.workTime is string && data.workTime.size() >= 1 && data.workTime.size() <= 60 &&
      isValidCount(data.generalPractice) &&
      isValidCount(data.chronicCare) &&
      isValidCount(data.homeVisit) &&
      isValidCount(data.medicalCert) &&
      isValidCount(data.specialProcedure) &&
      data.reporterPrefix is string && data.reporterPrefix.size() <= 40 &&
      data.reporterFirstName is string && data.reporterFirstName.size() >= 1 && data.reporterFirstName.size() <= 80 &&
      data.reporterLastName is string && data.reporterLastName.size() >= 1 && data.reporterLastName.size() <= 80 &&
      data.reporterPosition is string && data.reporterPosition.size() <= 100 &&
      data.reporterLevel is string && data.reporterLevel.size() <= 60 &&
      data.notes is string && data.notes.size() <= 1000 &&
      data.visibility is string && data.visibility == 'node_doi_yao' &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    // 4. Collection Rules: /medical_logs/{logId}
    match /medical_logs/{logId} {
      allow get: if isSignedIn() && isValidId(logId) && existing().visibility == 'node_doi_yao';
      allow list: if isSignedIn() && existing().visibility == 'node_doi_yao';

      allow create: if isVerifiedUser() &&
        isValidId(logId) &&
        isValidMedicalLog(incoming(), logId) &&
        incoming().authorUid == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isVerifiedUser() &&
        isValidId(logId) &&
        isValidMedicalLog(incoming(), logId) &&
        incoming().id == existing().id &&
        incoming().authorUid == existing().authorUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          isAdmin() ||
          (
            incoming().authorUid == request.auth.uid &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'serviceUnitCode',
              'serviceUnitName',
              'date',
              'doctorName',
              'hospital',
              'workTime',
              'generalPractice',
              'chronicCare',
              'homeVisit',
              'medicalCert',
              'specialProcedure',
              'reporterPrefix',
              'reporterFirstName',
              'reporterLastName',
              'reporterPosition',
              'reporterLevel',
              'notes',
              'updatedAt'
            ])
          )
        );

      allow delete: if isVerifiedUser() &&
        isValidId(logId) && (
          isAdmin() ||
          existing().authorUid == request.auth.uid
        );
    }

    // 5. Admins Lookup Collection
    match /admins/{adminUid} {
      allow get: if isSignedIn() && isValidId(adminUid) && request.auth.uid == adminUid;
      allow list, create, update, delete: if false;
    }
  }
}
