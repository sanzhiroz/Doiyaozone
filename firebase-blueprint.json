{
  "entities": {
    "MedicalLog": {
      "title": "MedicalLog",
      "description": "Shared medical practice log entry recorded by service units in Node Doi Yao",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier of the medical log record",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "authorUid": {
          "type": "string",
          "description": "Firebase Auth UID of the creator",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "serviceUnitCode": {
          "type": "string",
          "description": "5-digit service unit code (05954, 05956, 05957, 05958, 05959)",
          "minLength": 5,
          "maxLength": 10,
          "pattern": "^[0-9]{5}$"
        },
        "serviceUnitName": {
          "type": "string",
          "description": "Name of the service unit",
          "minLength": 1,
          "maxLength": 120
        },
        "date": {
          "type": "string",
          "description": "Practice date in YYYY-MM-DD format",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "doctorName": {
          "type": "string",
          "description": "Doctor full name",
          "minLength": 1,
          "maxLength": 120
        },
        "hospital": {
          "type": "string",
          "description": "Target hospital / service unit where the doctor practiced",
          "minLength": 1,
          "maxLength": 120
        },
        "workTime": {
          "type": "string",
          "description": "Work time slot string",
          "minLength": 1,
          "maxLength": 60
        },
        "generalPractice": {
          "type": "number",
          "description": "4.1 General practice patient count"
        },
        "chronicCare": {
          "type": "number",
          "description": "4.2 Chronic care patient count"
        },
        "homeVisit": {
          "type": "number",
          "description": "4.3 Home visit patient count"
        },
        "medicalCert": {
          "type": "number",
          "description": "4.4 Medical certificate count"
        },
        "specialProcedure": {
          "type": "number",
          "description": "4.5 Special procedure count"
        },
        "reporterPrefix": {
          "type": "string",
          "description": "Reporter prefix",
          "minLength": 0,
          "maxLength": 40
        },
        "reporterFirstName": {
          "type": "string",
          "description": "Reporter first name",
          "minLength": 1,
          "maxLength": 80
        },
        "reporterLastName": {
          "type": "string",
          "description": "Reporter last name",
          "minLength": 1,
          "maxLength": 80
        },
        "reporterPosition": {
          "type": "string",
          "description": "Reporter position",
          "minLength": 0,
          "maxLength": 100
        },
        "reporterLevel": {
          "type": "string",
          "description": "Reporter level",
          "minLength": 0,
          "maxLength": 60
        },
        "notes": {
          "type": "string",
          "description": "Additional notes",
          "minLength": 0,
          "maxLength": 1000
        },
        "visibility": {
          "type": "string",
          "description": "Shared visibility across Node Doi Yao network",
          "enum": ["node_doi_yao"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update timestamp"
        }
      },
      "required": [
        "id",
        "authorUid",
        "serviceUnitCode",
        "serviceUnitName",
        "date",
        "doctorName",
        "hospital",
        "workTime",
        "generalPractice",
        "chronicCare",
        "homeVisit",
        "medicalCert",
        "specialProcedure",
        "reporterPrefix",
        "reporterFirstName",
        "reporterLastName",
        "reporterPosition",
        "reporterLevel",
        "notes",
        "visibility",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/medical_logs/{logId}": {
      "schema": {
        "$ref": "#/entities/MedicalLog"
      },
      "description": "Shared collection of medical practice logs across all service units in Node Doi Yao"
    }
  }
}
